; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="IndieCure"
run/main_scene="res://Scenes/Worlds/MainMenu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

ProjectSettingsIc="res://Scripts/Tools/ProjectSettingsIC.gd"
Questify="*res://addons/questify/quest_manager.gd"
GUIDE="*res://addons/guide/guide.gd"
InputHandler="*res://Scripts/Global/InputHandler.gd"
Settings="*res://Scripts/UI/Settings/Settings.gd"
Global="*res://Scripts/Global/Global.gd"
MessageBus="*res://Scripts/Global/MessageBus.gd"
CollisionAvoidance="*res://Scripts/Global/CollisionAvoidance.gd"
DebugUi="*res://Scripts/Global/DebugUI.tscn"
Stat="*res://Scripts/GAS/Attributes/Stat.gd"
StatEditorSave="*res://addons/custominspectors/stat_editor/stat_editor_save.gd"
DamageNumbers="*res://Scripts/Global/DamagePopup/damage_numbers.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[debug]

gdscript/warnings/unused_parameter=0

[dialogue_manager]

runtime/balloon_path="res://Scenes/Dialogue/Basic/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/borderless=true
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="IndieCure"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/custominspectors/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/enemytimeline/plugin.cfg", "res://addons/guide/plugin.cfg", "res://addons/itemcreator/plugin.cfg", "res://addons/json_editor/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/post_processing/plugin.cfg", "res://addons/process_mode_indicator/plugin.cfg", "res://addons/quest_resource_translation_parser/plugin.cfg", "res://addons/questify/plugin.cfg")

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":115,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
]
}
switch_attack_mode={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(166, 1),"global_position":Vector2(170, 42),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[internationalization]

locale/translations_pot_files=PackedStringArray("res://Data/Dialogues/00_tutorial_01.dialogue", "res://Data/Dialogues/00_tutorial_02.dialogue", "res://Data/Dialogues/00_tutorial_03.dialogue")

[layer_names]

2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerBody"
2d_physics/layer_19="XP"

[physics]

2d/run_on_separate_thread=true
common/physics_jitter_fix=0.0
2d/solver/solver_iterations=6
common/physics_interpolation=true

[questify]

general/update_polling=true
general/update_interval=0.5
general/add_quests_to_pot_generation=false

[rendering]

textures/canvas_textures/default_texture_filter=0
viewport/hdr_2d=true

[shader_globals]

player_pos={
"type": "vec2",
"value": Vector2(-29.4, -15)
}
